# Optional. Enables Ledgr AI's model-backed answers. Without it, Ledgr AI
# runs in offline mode and answers from the calculation engine only.
ANTHROPIC_API_KEY=

# Optional. Enables accounts (sign up / log in / Google) and cloud sync.
# From your Supabase project: Settings → API. The anon key is safe to expose to browsers;
# access is enforced by the row-level security policies in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Real price candles on Showcase P&L cards (fetched only when you click
# "Load price chart", then saved with the trade). Works with NO keys: crypto uses Binance,
# forex / futures / stocks / indices use Yahoo Finance (free; 1-minute history for the last ~30 days).
# The keys below are optional alternatives.
# Stocks, ETFs and forex — free key at twelvedata.com
TWELVEDATA_API_KEY=
# CME futures (NQ, ES, MNQ, CL, GC …) — key at databento.com (pay-as-you-go; new accounts get free credit)
DATABENTO_API_KEY=


# Optional. MatrixX (getmatrixx.com) on the AI page. Without a server key, each user
# pastes their own MatrixX key in "Connect MatrixX". With a server key, answers stream
# into Ledgr from MatrixX Cloud's OpenAI-style API (server only — never NEXT_PUBLIC_).
MATRIXX_API_KEY=
# MATRIXX_API_URL=https://getmatrixx.com/v1
# MATRIXX_MODEL=
