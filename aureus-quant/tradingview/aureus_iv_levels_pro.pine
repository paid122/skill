//@version=6
indicator("AUREUS IV Levels Pro", overlay = true, max_lines_count = 100, max_labels_count = 100)

// Daily + weekly implied-volatility zones, plus options levels (daily ceiling / floor, walls,
// max pain, gamma flip) pasted from AUREUS ("Copy for TradingView").
//   M(day)  = day open  × IV/100 × sqrt(1/252)    M(week) = week open × IV/100 × sqrt(5/252)
//   Normal zone = open ± 0.67..1.00 M     Wall zone = open ± 1.65..1.96 M
// IV is fixed at the start of each period (no repainting). TradingView cannot read option
// open interest, so the options levels come from AUREUS (GLD options mapped to gold prices).

src      = input.string("Manual GVZ", "Volatility source", options = ["Manual GVZ", "GVZ symbol", "Realised vol (no GVZ needed)"])
ivManual = input.float(0.0, "Manual GVZ value (e.g. 34.8)", minval = 0, step = 0.1)
ivSym    = input.string("CBOE:GVZ", "GVZ symbol (only used with 'GVZ symbol')")

showD = input.bool(true, "Daily IV zones",  group = "IV zones")
showW = input.bool(true, "Weekly IV zones", group = "IV zones")
kN1   = input.float(0.67, "Normal zone from (×M)", step = 0.05, group = "IV zones")
kN2   = input.float(1.00, "Normal zone to (×M)",   step = 0.05, group = "IV zones")
kW1   = input.float(1.65, "Wall zone from (×M)",   step = 0.05, group = "IV zones")
kW2   = input.float(1.96, "Wall zone to (×M)",     step = 0.05, group = "IV zones")

levelsTxt  = input.text_area("", "AUREUS options levels (paste from 'Copy for TradingView')", group = "Options levels")
zonePct    = input.float(0.04, "Ceiling / floor zone half-width (%)", minval = 0, step = 0.01, group = "Options levels")
maxAgeDays = input.int(1, "Warn if options levels older than (days)", minval = 1, group = "Options levels")
showT      = input.bool(true, "Show info table")

// ---------------------------------------------------------------- volatility --
symUse  = src == "GVZ symbol" ? ivSym : syminfo.tickerid
ivLastA = request.security(symUse, "D", close,    lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
ivPrevA = request.security(symUse, "D", close[1], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
rv21    = request.security(syminfo.tickerid, "D", (ta.stdev(math.log(close / close[1]), 21) * math.sqrt(252) * 100)[1], lookahead = barmerge.lookahead_on)
manIV   = ivManual > 0 ? ivManual : na
ivLast  = src == "Manual GVZ" ? manIV : src == "GVZ symbol" ? ivLastA : rv21
ivPrev  = src == "Manual GVZ" ? manIV : src == "GVZ symbol" ? ivPrevA : rv21
startHr = hour(time, "America/New_York") + minute(time, "America/New_York") / 60.0
ivNow   = nz((startHr >= 16.25 or startHr < 9.5) ? ivLast : ivPrev, nz(ivLast, ivPrev))

oD   = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_on)
oW   = request.security(syminfo.tickerid, "W", open, lookahead = barmerge.lookahead_on)
newD = timeframe.change("D")
newW = timeframe.change("W")

var float dO = na
var float dM = na
var float dIV = na
var float wO = na
var float wM = na
var float wIV = na
if newD
    dO  := oD
    dIV := ivNow
    dM  := oD * ivNow / 100 * math.sqrt(1.0 / 252)
if newW
    wO  := oW
    wIV := ivNow
    wM  := oW * ivNow / 100 * math.sqrt(5.0 / 252)

// ------------------------------------------------------------- daily zones --
okD = showD and not na(dM) and dM > 0 and not newD
d1 = plot(okD ? dO + kW2 * dM : na, "Daily Wall High top",    color.new(#0ca30c, 55), 1, plot.style_linebr)
d2 = plot(okD ? dO + kW1 * dM : na, "Daily Wall High bottom", color.new(#0ca30c, 55), 1, plot.style_linebr)
d3 = plot(okD ? dO + kN2 * dM : na, "Daily Normal High top",    color.new(#3987e5, 55), 1, plot.style_linebr)
d4 = plot(okD ? dO + kN1 * dM : na, "Daily Normal High bottom", color.new(#3987e5, 55), 1, plot.style_linebr)
d5 = plot(okD ? dO - kN1 * dM : na, "Daily Normal Low top",    color.new(#3987e5, 55), 1, plot.style_linebr)
d6 = plot(okD ? dO - kN2 * dM : na, "Daily Normal Low bottom", color.new(#3987e5, 55), 1, plot.style_linebr)
d7 = plot(okD ? dO - kW1 * dM : na, "Daily Wall Low top",    color.new(#e66767, 55), 1, plot.style_linebr)
d8 = plot(okD ? dO - kW2 * dM : na, "Daily Wall Low bottom", color.new(#e66767, 55), 1, plot.style_linebr)
fill(d1, d2, color.new(#0ca30c, 88), "Daily Wall High")
fill(d3, d4, color.new(#3987e5, 88), "Daily Normal High")
fill(d5, d6, color.new(#3987e5, 88), "Daily Normal Low")
fill(d7, d8, color.new(#e66767, 88), "Daily Wall Low")
plot(okD ? dO : na, "Daily open", color.new(#c9a54c, 50), 1, plot.style_linebr)

// ------------------------------------------------------------ weekly zones --
okW = showW and not na(wM) and wM > 0 and not newW
w1 = plot(okW ? wO + kW2 * wM : na, "Weekly Wall High top",    color.new(#0ca30c, 10), 2, plot.style_linebr)
w2 = plot(okW ? wO + kW1 * wM : na, "Weekly Wall High bottom", color.new(#0ca30c, 10), 2, plot.style_linebr)
w3 = plot(okW ? wO + kN2 * wM : na, "Weekly Normal High top",    color.new(#3987e5, 10), 2, plot.style_linebr)
w4 = plot(okW ? wO + kN1 * wM : na, "Weekly Normal High bottom", color.new(#3987e5, 10), 2, plot.style_linebr)
w5 = plot(okW ? wO - kN1 * wM : na, "Weekly Normal Low top",    color.new(#3987e5, 10), 2, plot.style_linebr)
w6 = plot(okW ? wO - kN2 * wM : na, "Weekly Normal Low bottom", color.new(#3987e5, 10), 2, plot.style_linebr)
w7 = plot(okW ? wO - kW1 * wM : na, "Weekly Wall Low top",    color.new(#e66767, 10), 2, plot.style_linebr)
w8 = plot(okW ? wO - kW2 * wM : na, "Weekly Wall Low bottom", color.new(#e66767, 10), 2, plot.style_linebr)
fill(w1, w2, color.new(#0ca30c, 80), "Weekly Wall High")
fill(w3, w4, color.new(#3987e5, 80), "Weekly Normal High")
fill(w5, w6, color.new(#3987e5, 80), "Weekly Normal Low")
fill(w7, w8, color.new(#e66767, 80), "Weekly Wall Low")
plot(okW ? wO : na, "Weekly open", color.new(#c9a54c, 10), 2, plot.style_linebr)

// --------------------------------------------------------- options levels --
getLevel(string txt, string key) =>
    float v = na
    parts = str.split(str.replace_all(txt, " ", ""), ";")
    for p in parts
        kv = str.split(p, "=")
        if array.size(kv) == 2 and str.upper(array.get(kv, 0)) == key
            v := str.tonumber(array.get(kv, 1))
    v

getText(string txt, string key) =>
    string v = ""
    parts = str.split(str.replace_all(txt, " ", ""), ";")
    for p in parts
        kv = str.split(p, "=")
        if array.size(kv) == 2 and str.upper(array.get(kv, 0)) == key
            v := array.get(kv, 1)
    v

ceil_  = getLevel(levelsTxt, "CEIL")
floor_ = getLevel(levelsTxt, "FLOOR")
cw     = getLevel(levelsTxt, "CW")
pw     = getLevel(levelsTxt, "PW")
gf     = getLevel(levelsTxt, "GF")
mp     = getLevel(levelsTxt, "MP")
lvDate = getText(levelsTxt, "D")
dParts = str.split(lvDate, "-")
lvTs   = array.size(dParts) == 3 ? timestamp("UTC", int(str.tonumber(array.get(dParts, 0))), int(str.tonumber(array.get(dParts, 1))), int(str.tonumber(array.get(dParts, 2))), 0, 0) : na
stale  = not na(lvTs) and (timenow - lvTs) / 86400000.0 > maxAgeDays + 1

var line[]  oLines  = array.new_line()
var label[] oLabels = array.new_label()
var linefill[] oFills = array.new_linefill()

drawLevel(float lvl, string name, color col, int width, string sty, bool zone) =>
    if not na(lvl)
        st = sty == "dashed" ? line.style_dashed : sty == "dotted" ? line.style_dotted : line.style_solid
        array.push(oLines, line.new(bar_index - 1, lvl, bar_index, lvl, extend = extend.both, color = col, width = width, style = st))
        array.push(oLabels, label.new(bar_index + 3, lvl, name + " " + str.tostring(lvl, "#.0"), style = label.style_label_left,
             color = color.new(col, 70), textcolor = color.white, size = size.small))
        if zone and zonePct > 0
            h = lvl * zonePct / 100
            lt = line.new(bar_index - 1, lvl + h, bar_index, lvl + h, extend = extend.both, color = color.new(col, 100))
            lb = line.new(bar_index - 1, lvl - h, bar_index, lvl - h, extend = extend.both, color = color.new(col, 100))
            array.push(oLines, lt)
            array.push(oLines, lb)
            array.push(oFills, linefill.new(lt, lb, color.new(col, 80)))

if barstate.islast
    for f in oFills
        linefill.delete(f)
    for l in oLines
        line.delete(l)
    for b in oLabels
        label.delete(b)
    array.clear(oFills)
    array.clear(oLines)
    array.clear(oLabels)
    drawLevel(ceil_, "Daily Ceiling", #e66767, 2, "solid", true)
    drawLevel(floor_, "Daily Floor", #0ca30c, 2, "solid", true)
    drawLevel(cw, "Call wall", #e66767, 1, "dashed", false)
    drawLevel(pw, "Put wall", #0ca30c, 1, "dashed", false)
    drawLevel(gf, "Gamma flip", #c9a54c, 1, "dotted", false)
    drawLevel(mp, "Max pain", #85847f, 1, "dotted", false)
    if okD
        array.push(oLabels, label.new(bar_index + 3, dO + (kN1 + kN2) / 2 * dM, "D Normal High", style = label.style_label_left, color = color.new(#3987e5, 80), textcolor = color.white, size = size.tiny))
        array.push(oLabels, label.new(bar_index + 3, dO - (kN1 + kN2) / 2 * dM, "D Normal Low", style = label.style_label_left, color = color.new(#3987e5, 80), textcolor = color.white, size = size.tiny))
    if okW
        array.push(oLabels, label.new(bar_index + 3, wO + (kW1 + kW2) / 2 * wM, "W Wall High " + str.tostring(wO + kW1 * wM, "#.0"), style = label.style_label_left, color = color.new(#0ca30c, 60), textcolor = color.white, size = size.small))
        array.push(oLabels, label.new(bar_index + 3, wO + (kN1 + kN2) / 2 * wM, "W Normal High " + str.tostring(wO + kN1 * wM, "#.0"), style = label.style_label_left, color = color.new(#3987e5, 60), textcolor = color.white, size = size.small))
        array.push(oLabels, label.new(bar_index + 3, wO - (kN1 + kN2) / 2 * wM, "W Normal Low " + str.tostring(wO - kN1 * wM, "#.0"), style = label.style_label_left, color = color.new(#3987e5, 60), textcolor = color.white, size = size.small))
        array.push(oLabels, label.new(bar_index + 3, wO - (kW1 + kW2) / 2 * wM, "W Wall Low " + str.tostring(wO - kW1 * wM, "#.0"), style = label.style_label_left, color = color.new(#e66767, 60), textcolor = color.white, size = size.small))
    if na(dM) and na(wM)
        array.push(oLabels, label.new(bar_index, close, src == "Manual GVZ" ? "AUREUS IV Levels: type this week's GVZ in Settings → 'Manual GVZ value' (e.g. 34.8)." : "AUREUS IV Levels: no volatility data — Settings → Volatility source → 'Manual GVZ' or 'Realised vol'.",
             style = label.style_label_left, color = color.new(#e66767, 0), textcolor = color.white, size = size.normal))

// ------------------------------------------------------------------ table --
var table t = table.new(position.top_right, 2, 7, bgcolor = color.new(#17181b, 5), border_color = color.new(#33363c, 0), border_width = 1)
cell(int r, string a, string b, color col) =>
    table.cell(t, 0, r, a, text_color = #b9b8b2, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, b, text_color = col, text_size = size.small, text_halign = text.align_right)

if showT and barstate.islast
    cell(0, "AUREUS IV Levels Pro", src == "Realised vol (no GVZ needed)" ? "RV" : "GVZ", #c9a54c)
    cell(1, "Vol used (week / day)", (na(wIV) ? "—" : str.tostring(wIV, "#.0")) + " / " + (na(dIV) ? "—" : str.tostring(dIV, "#.0")), #f0efec)
    cell(2, "Weekly normal move ±M", na(wM) ? "—" : "±" + str.tostring(wM, "#.0"), #f0efec)
    cell(3, "Daily normal move ±M", na(dM) ? "—" : "±" + str.tostring(dM, "#.0"), #f0efec)
    cell(4, "Daily ceiling / floor", (na(ceil_) ? "—" : str.tostring(ceil_, "#.0")) + " / " + (na(floor_) ? "—" : str.tostring(floor_, "#.0")), #f0efec)
    cell(5, "Options levels as of", lvDate == "" ? "not pasted" : lvDate + (stale ? "  STALE" : ""), lvDate == "" or stale ? #e66767 : #0ca30c)
    cell(6, "Zones = range, not direction · test before trusting", "", #85847f)
