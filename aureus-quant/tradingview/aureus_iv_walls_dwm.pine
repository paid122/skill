//@version=6
indicator("AUREUS IV Walls (Day/Week/Month)", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// Implied-volatility walls for the day, week or month, that track themselves.
//   M      = period open × GVZ/100 × sqrt(days/252)   days = 1 (day), 5 (week), 21 (month)
//            GVZ = last close available when the period starts (no look-ahead)
//   Normal = open ± 0.67..1.00 M    Wall = open ± 1.65..1.96 M
// Every day the script records how far the high and low travelled (in M) and where the day closed,
// and the table shows, over the last N days:
//   Touched  = share of days that reached the zone (vs theory 2·(1−Φ(k)))
//   Held     = of the days that touched it, share that CLOSED back inside (on the open's side of the zone)
//   Broke    = of the days that touched it, share that traded beyond the far edge of the box
// Touch markers: ▼ = upper zone touched, ▲ = lower zone touched (first touch of each zone per day).

perName  = input.string("Month", "Period", options = ["Day", "Week", "Month"])
ivSym    = input.symbol("CBOE:GVZ", "IV index (annualised %)")
keepDays = input.int(6, "Show boxes for the last N periods", minval = 1, maxval = 100)
kN1      = input.float(0.67, "Normal zone from (×M)", step = 0.05, group = "Zones")
kN2      = input.float(1.00, "Normal zone to (×M)",   step = 0.05, group = "Zones")
kW1      = input.float(1.65, "Wall zone from (×M)",   step = 0.05, group = "Zones")
kW2      = input.float(1.96, "Wall zone to (×M)",     step = 0.05, group = "Zones")
lookN    = input.int(120, "Stats lookback (periods)", minval = 10, group = "Stats")

tf    = perName == "Day" ? "D" : perName == "Week" ? "W" : "M"
nDays = perName == "Day" ? 1.0 : perName == "Week" ? 5.0 : 21.0
showT    = input.bool(true, "Show stats table", group = "Stats")
showMk   = input.bool(true, "Show touch markers", group = "Stats")

// ------------------------------------------------------------------ data --
dOpen  = request.security(syminfo.tickerid, tf, open, lookahead = barmerge.lookahead_on)
ivLast = request.security(ivSym, "D", close,    lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
ivPrev = request.security(ivSym, "D", close[1], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
newDay = timeframe.change(tf)

// The GVZ cash session ends 16:15 New York. If this chart's trading day starts after that (CME/most
// XAUUSD brokers start ~18:00 NY) or before 09:30 NY, the latest GVZ close is already final -> use it.
// If the day starts during US hours, use the previous close so no unfinished value is used.
startHr  = hour(time, "America/New_York") + minute(time, "America/New_York") / 60.0
ivForDay = (startHr >= 16.25 or startHr < 9.5) ? ivLast : ivPrev

phi(float x) =>
    z = math.abs(x) / math.sqrt(2.0)
    tt = 1.0 / (1.0 + 0.3275911 * z)
    y = 1.0 - (((((1.061405429 * tt - 1.453152027) * tt) + 1.421413741) * tt - 0.284496736) * tt + 0.254829592) * tt * math.exp(-z * z)
    x >= 0 ? 0.5 * (1.0 + y) : 0.5 * (1.0 - y)
theory(float k) => 2.0 * (1.0 - phi(k))

// ---------------------------------------------------------- day state ----
var float dO = na
var float dM = na
var float dHi = na
var float dLo = na
var float dC = na
var float dIV = na
var array<float> upK = array.new_float()
var array<float> dnK = array.new_float()
var array<float> clK = array.new_float()
var array<box> boxes = array.new_box()
var bool tNH = false
var bool tNL = false
var bool tWH = false
var bool tWL = false

zone(int t0, int t1, float top, float bot, color c, string txt) =>
    box.new(t0, top, t1, bot, xloc = xloc.bar_time, bgcolor = color.new(c, 84), border_color = color.new(c, 45),
         text = txt, text_size = size.tiny, text_color = color.new(c, 0), text_halign = text.align_right, text_valign = text.align_center)

if newDay
    // 1) finalise the day that just ended
    if not na(dM) and dM > 0
        array.push(upK, (dHi - dO) / dM)
        array.push(dnK, (dO - dLo) / dM)
        array.push(clK, (dC - dO) / dM)
        if array.size(upK) > lookN
            array.shift(upK)
            array.shift(dnK)
            array.shift(clK)
    // 2) start the new day
    dO  := dOpen
    dIV := ivForDay
    dM  := dOpen * ivForDay / 100 * math.sqrt(nDays / 252)
    dHi := high
    dLo := low
    tNH := false
    tNL := false
    tWH := false
    tWL := false
    if not na(dM) and dM > 0
        t1 = nz(time_close(tf), time + int(nDays * 1.45) * 86400000)
        array.push(boxes, zone(time, t1, dO + kW2 * dM, dO + kW1 * dM, #0ca30c, perName + " Wall High"))
        array.push(boxes, zone(time, t1, dO + kN2 * dM, dO + kN1 * dM, #3987e5, perName + " Normal High"))
        array.push(boxes, zone(time, t1, dO - kN1 * dM, dO - kN2 * dM, #3987e5, perName + " Normal Low"))
        array.push(boxes, zone(time, t1, dO - kW1 * dM, dO - kW2 * dM, #e66767, perName + " Wall Low"))
        while array.size(boxes) > keepDays * 4
            box.delete(array.shift(boxes))
else
    dHi := math.max(dHi, high)
    dLo := math.min(dLo, low)
dC := close

// ------------------------------------------------------- touch markers ---
lvNH = dO + kN1 * dM
lvNL = dO - kN1 * dM
lvWH = dO + kW1 * dM
lvWL = dO - kW1 * dM
hitNH = not tNH and high >= lvNH
hitNL = not tNL and low <= lvNL
hitWH = not tWH and high >= lvWH
hitWL = not tWL and low <= lvWL
if hitNH
    tNH := true
if hitNL
    tNL := true
if hitWH
    tWH := true
if hitWL
    tWL := true

plotshape(showMk and hitNH and not hitWH, "Normal High touch", shape.triangledown, location.abovebar, #3987e5, size = size.tiny)
plotshape(showMk and hitNL and not hitWL, "Normal Low touch",  shape.triangleup,   location.belowbar, #3987e5, size = size.tiny)
plotshape(showMk and hitWH, "Wall High touch", shape.triangledown, location.abovebar, #0ca30c, size = size.small)
plotshape(showMk and hitWL, "Wall Low touch",  shape.triangleup,   location.belowbar, #e66767, size = size.small)
plot(dO, "Period open", color.new(#c9a54c, 40), 1, plot.style_stepline)

alertcondition(hitNH or hitNL, "Normal zone touched", "AUREUS: price touched a Normal IV zone")
alertcondition(hitWH or hitWL, "Wall zone touched", "AUREUS: price touched a Wall IV zone")
if hitWH or hitWL
    alert("AUREUS: " + perName + " " + (hitWH ? "Wall High" : "Wall Low") + " touched at " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
else if hitNH or hitNL
    alert("AUREUS: " + perName + " " + (hitNH ? "Normal High" : "Normal Low") + " touched at " + str.tostring(close, format.mintick), alert.freq_once_per_bar)

// --------------------------------------------------------------- stats ---
// returns [touch rate, held rate, broke rate, touches] for a zone k1..k2, both sides combined
stats(float k1, float k2) =>
    n = array.size(upK)
    int touches = 0
    int held = 0
    int broke = 0
    if n > 0
        for i = 0 to n - 1
            u = array.get(upK, i)
            d = array.get(dnK, i)
            c = array.get(clK, i)
            if u >= k1
                touches += 1
                held += c < k1 ? 1 : 0
                broke += u > k2 ? 1 : 0
            if d >= k1
                touches += 1
                held += -c < k1 ? 1 : 0
                broke += d > k2 ? 1 : 0
    tr = n > 0 ? touches / (2.0 * n) : na
    hr = touches > 0 ? held * 1.0 / touches : na
    br = touches > 0 ? broke * 1.0 / touches : na
    [tr, hr, br, touches]

pct(float v) => na(v) ? "—" : str.tostring(v * 100, "#") + "%"

var table t = table.new(position.top_right, 5, 6, bgcolor = color.new(#17181b, 5), border_color = color.new(#33363c, 0), border_width = 1)
put(int c, int r, string s, color col) =>
    table.cell(t, c, r, s, text_color = col, text_size = size.small)

if showT and barstate.islast
    n = array.size(upK)
    [nTr, nHr, nBr, nTo] = stats(kN1, kN2)
    [wTr, wHr, wBr, wTo] = stats(kW1, kW2)
    put(0, 0, "AUREUS IV Walls · " + perName, #c9a54c)
    put(1, 0, "GVZ " + (na(dIV) ? "n/a" : str.tostring(dIV, "#.0")), #b9b8b2)
    put(2, 0, "M " + (na(dM) ? "—" : str.tostring(dM, "#.0")), #b9b8b2)
    put(3, 0, "open " + (na(dO) ? "—" : str.tostring(dO, format.mintick)), #b9b8b2)
    put(4, 0, str.tostring(n) + " periods", #b9b8b2)
    put(0, 1, "Zone", #85847f)
    put(1, 1, "Touched (theory)", #85847f)
    put(2, 1, "Held at close", #85847f)
    put(3, 1, "Broke past box", #85847f)
    put(4, 1, "Touches", #85847f)
    put(0, 2, "Normal " + str.tostring(kN1) + "–" + str.tostring(kN2) + "M", #3987e5)
    put(1, 2, pct(nTr) + " (" + pct(theory(kN1)) + ")", #f0efec)
    put(2, 2, pct(nHr), #f0efec)
    put(3, 2, pct(nBr), #f0efec)
    put(4, 2, str.tostring(nTo), #f0efec)
    put(0, 3, "Wall " + str.tostring(kW1) + "–" + str.tostring(kW2) + "M", #0ca30c)
    put(1, 3, pct(wTr) + " (" + pct(theory(kW1)) + ")", #f0efec)
    put(2, 3, pct(wHr), #f0efec)
    put(3, 3, pct(wBr), #f0efec)
    put(4, 3, str.tostring(wTo), #f0efec)
    put(0, 4, "Held = period closed back inside the zone's start · Broke = traded past the far edge", #85847f)
    put(0, 5, "Fewer than ~30 touches = not enough to trust", #85847f)
    table.merge_cells(t, 0, 4, 4, 4)
    table.merge_cells(t, 0, 5, 4, 5)
