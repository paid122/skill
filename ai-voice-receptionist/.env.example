# --- Vapi ---
# From https://dashboard.vapi.ai/org/api-keys (Private key, used server-side)
VAPI_API_KEY=

# Filled in automatically by `npm run create-assistant`, or paste manually
VAPI_ASSISTANT_ID=

# Filled in automatically by `npm run create-outbound-assistant`, or paste manually
VAPI_OUTBOUND_ASSISTANT_ID=

# Filled in automatically by `npm run setup-phone-number`, or paste manually
VAPI_PHONE_NUMBER_ID=

# Shared secret required on every request to POST /trigger-missed-call, since that
# endpoint places real outbound calls. Generate a random string; give it to whatever
# system (Twilio, Zapier, your CRM) will call this endpoint, as the x-webhook-secret header.
MISSED_CALL_WEBHOOK_SECRET=

# Public URL of THIS server once deployed (Railway/Render/Fly/etc).
# Vapi will POST tool calls and end-of-call reports here.
# e.g. https://your-app.up.railway.app
PUBLIC_SERVER_URL=

# Optional shared secret: Vapi sends this back in the x-vapi-secret header
# on every webhook so you can verify requests actually came from Vapi.
VAPI_WEBHOOK_SECRET=change-me-to-a-random-string

# --- Business info (used in the assistant's system prompt) ---
BUSINESS_NAME="Your Business Name"
BUSINESS_HOURS="Mon-Fri 9am-6pm"
BUSINESS_SERVICES="General consultation, follow-up visit"
TRANSFER_PHONE_NUMBER=+15555550123

# --- Google Calendar (for check_availability / book_appointment tools) ---
# See docs/SETUP.md for how to get these via `npm run google-auth`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Slack (optional: post call summaries / new bookings) ---
SLACK_WEBHOOK_URL=

# --- Server ---
PORT=3000
